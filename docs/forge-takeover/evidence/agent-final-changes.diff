+pub fn status_summary(project_id: i32) -> anyhow::Result<StatusSummary> {
+    let tasks = fetch_tasks(project_id)?;
+    let now = Utc::now().timestamp();
+    let mut summary = StatusSummary {
+        todo: 0,
+        in_progress: 0,
+        done: 0,
+        leased: 0,
+        unassigned: 0,
+        next: Vec::new(),
